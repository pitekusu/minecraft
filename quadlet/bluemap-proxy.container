[Unit]
Description=BlueMap reverse proxy
Wants=bluemap.service
After=bluemap.service

[Container]
Image=docker.io/library/caddy:2.11.9-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
ContainerName=tfg-bluemap-proxy
Network=bluemap.network
User=65534:65534
LogDriver=journald
Volume=%h/codex/minecraft/quadlet/bluemap-proxy.Caddyfile:/etc/caddy/Caddyfile:ro
PublishPort=127.0.0.1:8100:8100/tcp

[Service]
Restart=always
RestartSec=10s
TimeoutStartSec=300s

[Install]
WantedBy=default.target
